# Bot token (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Guild ids where slash commands should be synced immediately.
# Empty means global sync, which can take up to an hour to propagate.
DISCORD_GUILD_IDS=

# Emission pacing, in seconds. 2.0 stays under the observed ceiling of roughly
# 30 webhook messages per minute per channel. Floors are enforced in code.
PROMOTER_MESSAGE_DELAY=2.0
PROMOTER_REACTION_DELAY=0.30

# Reactions are off by default: a bot can only react as itself, so replaying
# them attributes everyone's reactions to the bot. Who reacted with what is
# kept as text under each message either way. Turn this on only if you want the
# coloured pills back and accept that they are all the bot's.
PROMOTER_REPLAY_REACTIONS=false
PROMOTER_REPLAY_ATTACHMENTS=true
PROMOTER_KEEP_ATTACHMENT_COPIES=true

PROMOTER_PROGRESS_EVERY=25
